+ * 先开空白页再导航的写法拿到的永远是 null，用户只看到一句转瞬即逝的
+ * "浏览器拦截了登录弹窗"。登录流程改在 host 侧（Node）直接拉起系统浏览器，
+ * 与 renderer 的窗口策略解耦。
+ */
+function openAuthUrl(url) {
+  if (typeof url !== 'string' || url.length === 0) return
+  try {
+    const [cmd, args] = process.platform === 'darwin'
+      ? ['open', [url]]
+      : process.platform === 'win32'
+        ? ['cmd', ['/c', 'start', '', url]]
+        : ['xdg-open', [url]]
+    const child = spawn(cmd, args, { stdio: 'ignore', detached: true })
+    child.on('error', () => {})
+    child.unref()
+  } catch {
+    // 打不开浏览器不影响 authUrl 已经返回给前端（用户可手动复制）
+  }
+}
