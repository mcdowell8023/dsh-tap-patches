+/**
+ * 渠道指纹脱敏表：网关入口渠道校验扫描正文里的客户端身份串，
+ * 命中即 400/11128 "unapproved channel"（2026-10-22 实测：同一 payload
+ * 仅替换 "DeepSeek Harness" 即从 11128 变为 200）。按序替换，只改身份
+ * 短语，不改其他语义。
+ */
+const IDENTITY_REWRITES = [
+  ['DeepSeek Harness', 'DeepSeek Assistant'],
+  ['deepseek-harness', 'deepseek-assistant'],
+]
+
+/** 递归就地替换 payload 内所有字符串中的身份短语。 */
+function scrubIdentityStrings(value) {
+  if (typeof value === 'string') {
+    let out = value
+    for (const [from, to] of IDENTITY_REWRITES) {
+      if (out.includes(from)) out = out.split(from).join(to)
+    }
+    return out
+  }
+  if (Array.isArray(value)) {
+    for (let i = 0; i < value.length; i += 1) value[i] = scrubIdentityStrings(value[i])
+    return value
+  }
+  if (value !== null && typeof value === 'object') {
+    for (const key of Object.keys(value)) value[key] = scrubIdentityStrings(value[key])
+    return value
+  }
+  return value
+}
